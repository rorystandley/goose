# Slack — from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# LLM Backend — 'ollama' (default) or 'vllm' (vllm-mlx, Apple Silicon optimised)
# LLM_BACKEND=ollama
# VLLM_PORT=8100                              # vllm-mlx listen port (avoids local 8000/8001 conflicts)
# VLLM_HOST=http://localhost:8100                # vllm-mlx API endpoint
# VLLM_MODEL=mlx-community/Qwen3.5-35B-A3B-4bit # Model served by vllm-mlx

# Ollama (used when LLM_BACKEND=ollama or unset)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Multi-model routing — optional, leave blank to always use OLLAMA_MODEL above
# FAST_MODEL=qwen2.5:7b        # Lean model for simple lookups and quick questions
# SMART_MODEL=qwen2.5:32b      # Capable model for complex reasoning and multi-step tasks
# ROUTING_MODEL=llama3.2:3b    # Tiny model that decides fast vs smart (omit to use heuristics)

# Search — add ONE (or more) of the following. First configured key is used.
# See docs/tools.md for details on each provider.
BRAVE_SEARCH_API_KEY=       # https://api.search.brave.com — paid
SERPER_API_KEY=             # https://serper.dev — 2,500 free Google results
TAVILY_API_KEY=             # https://tavily.com — 1,000 free req/month, built for AI

# Agent behaviour
AGENT_NAME=Goose
MAX_TOOL_ITERATIONS=10
REQUIRE_APPROVAL=true        # Set false to skip approval prompts (not recommended)
ALLOWED_PATHS=/Users         # Comma-separated root paths the agent can read/write
# MEMORY_PATH=data/memory.json      # Where Goose persists conversation memory (default: data/memory.json)
# FACTS_PATH=data/facts.json        # Where Goose persists long-term facts about the user (default: data/facts.json)
# THOUGHTS_PATH=data/thoughts.jsonl # Where Goose logs its thought journal (default: data/thoughts.jsonl)

# Plugins — drop tool packages into plugins/ or install @goose-tools/* npm packages
# PLUGINS_DIR=plugins               # Directory scanned for local plugin packages (default: ./plugins)

# Scheduler — copy missions.example.json to data/missions.json to activate
# MISSIONS_PATH=data/missions.json        # Path to scheduled missions config (default: data/missions.json)
# SCHEDULER_ALLOW_DANGEROUS=false         # Allow write_file/run_command in scheduled missions (default: false)

# Monitors — copy monitors.example.json to data/monitors.json to activate
# MONITORS_PATH=data/monitors.json        # Path to proactive monitors config (default: data/monitors.json)
# MONITORS_ALLOW_DANGEROUS=false          # Allow write_file/run_command in monitors (default: false)

# Web UI — run `npm run web` to open the browser dashboard
# WEB_ENABLED=true                        # Set to true to start the web UI (default: false)
# WEB_PORT=3000                           # Port for the web UI HTTP server (default: 3000)

# Voice interface — run `npm run voice`
#   Requires: brew install sox whisper-cpp
#   Note: Homebrew installs the binary as "whisper-cli" (not "whisper-cpp")
#   Model files are not bundled — download separately (see docs/voice.md):
#     mkdir -p ~/.cache/whisper
#     curl -L -o ~/.cache/whisper/ggml-base.en.bin \
#       https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin
# VOICE_WHISPER_MODEL=base.en             # Whisper model name or absolute path to .bin file (default: base.en)
# VOICE_TTS_BACKEND=say                   # say | mlx (default: say)
# VOICE_MLX_TTS_URL=http://127.0.0.1:7860 # https://github.com/rorystandley/mlx-tts-studio
# VOICE_MLX_TTS_MODEL=mlx-community/Kokoro-82M-bf16
# VOICE_MLX_TTS_VOICE=af_heart
# VOICE_MLX_TTS_LANGUAGE=a
# VOICE_MLX_TTS_INSTRUCT=                  # VoiceDesign instruction prompt for compatible models
# VOICE_MLX_TTS_TEMPERATURE=               # Optional sampler temperature for compatible models
# VOICE_MLX_TTS_TIMEOUT_MS=120000

# Audio library (Ops tab)
# AUDIO_PATH=./data/audio.json
# Required for the Ops tab to stream/delete generated audio files. Comma-separated
# list of directories Goose is allowed to read/unlink audio from. Without this,
# the Audio Library tile renders manifest entries but cannot play or delete them.
# AUDIO_OUTPUT_DIRS=/Users/you/Apps/mlx-tts-studio/outputs

# Logging
LOG_LEVEL=info               # debug | info | warn | error  (default: info)

# Persistent Kanban/mission checkpoints and process locks (default data/runs)
# RUNS_PATH=data/runs

# ── Crypto plugin (@goose-plugins/crypto) ─────────────────────────
# Optional CoinGecko key for higher rate limits (public API works without it)
# COINGECKO_API_KEY=
# COINGECKO_PRO=false
# COINGECKO_TIMEOUT_MS=15000
# CRYPTO_WATCHLIST_PATH=./data/crypto-watchlist.json
