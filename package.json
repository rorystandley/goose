{
  "name": "goose",
  "version": "1.0.0",
  "description": "Goose — a personal autonomous Slack agent powered by local Ollama LLM",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "cli": "node src/cli.js",
    "web": "WEB_ENABLED=true node src/cli.js",
    "dev:web": "WEB_ENABLED=true node --watch src/cli.js",
    "voice": "node src/voice.js",
    "dev:voice": "node --watch src/voice.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@goose-plugins/backup": "file:../goose-plugins/backup",
    "@goose-plugins/twitter": "file:../goose-plugins/twitter",
    "@slack/bolt": "^3.19.0",
    "dotenv": "^16.4.5",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "ollama": "^0.6.3",
    "openai": "^6.32.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@slack/socket-mode": "^2.0.5"
  }
}
